# Python FastAPI listens on this port. macOS often reserves 5000 for AirPlay.
PORT=5050
CLIENT_ORIGIN=http://localhost:5050
SERVE_CLIENT=false

# Next.js server proxy target (server-side) and iframe map target (client-side).
# For local `npm run dev` set NEXT_PUBLIC_BACKEND_URL=http://localhost:5050.
# Leave NEXT_PUBLIC_BACKEND_URL empty in production (backend serves the frontend).
BACKEND_URL=http://localhost:5050
NEXT_PUBLIC_BACKEND_URL=http://localhost:5050

# Optional. The map, search, tolls, and eateries work without MongoDB.
MONGODB_URI=

# Traffic provider. "here" and "tomtom" are implemented adapters (flow by bbox).
TRAFFIC_PROVIDER=here
# Used by the active provider. For TomTom you can also set TOMTOM_API_KEY below.
TRAFFIC_API_KEY=
HERE_API_BASE_URL=https://data.traffic.hereapi.com/v7
# Comma-separated HERE functional road classes (1–5). Empty means no class filter.
# 1–4 keeps requests inside a city viewport smaller. Class 5 is local streets.
HERE_FUNCTIONAL_CLASSES=1,2,3,4
# TomTom Traffic Flow (flowSegmentData). Set TRAFFIC_PROVIDER=tomtom and paste your key.
# If TOMTOM_API_KEY is empty, the app falls back to TRAFFIC_API_KEY.
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com/traffic/services
TOMTOM_TRAFFIC_VERSION=4
# Zoom controls road detail/coverage (0–22). 12 is a good city default.
TOMTOM_ZOOM=12
# The standard key only has the point-based flow API, so each map area is sampled
# on a N x N grid of points (N=3 -> 9 requests per area). Range 2–5.
TOMTOM_GRID=3

MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Default map view. Bengaluru is the initial city.
DEFAULT_LNG=77.5946
DEFAULT_LAT=12.9716
DEFAULT_ZOOM=14
DEFAULT_LABEL=Bengaluru

# Nominatim (OpenStreetMap) is the default geocoder. Identify this application.
# See https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TrafficIQ/1.0 (local development; set a contact address)

# Public Overpass endpoints, tried in order. Do not raise request rates.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
APP_USER_AGENT=TrafficIQ/1.0 (local development overpass client)

TRAFFIC_POLL_INTERVAL_MS=60000
TRAFFIC_CACHE_TTL_MS=30000
TRAFFIC_STALE_MAX_AGE_MS=900000
PLACES_CACHE_TTL_MS=600000
PLACES_STALE_MAX_AGE_MS=1800000
MAX_BBOX_SPAN_DEGREES=0.22
REQUEST_TIMEOUT_MS=20000
OVERPASS_TIMEOUT_MS=45000

TRAFFIC_PERSIST_SNAPSHOTS=false

LOG_LEVEL=info
